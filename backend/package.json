{
  "name": "teammatch-backend",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "start": "npm run build && node dist/index.js",
    "dev": "tsx watch index.ts",
    "test": "vitest --run",
    "test:integration": "vitest --run tests/integration",
    "test:neo4j": "vitest --run tests/integration --config vitest.neo4j.config.ts",
    "test:security": "vitest --run src/shared/security backend/tests/integration/security.routes.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.18.2",
    "file-type": "^22.0.1",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "neo4j-driver": "^5.15.0",
    "pdf-parse": "^2.4.5",
    "pdf2pic": "^3.2.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.10.6",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.6"
  }
}
