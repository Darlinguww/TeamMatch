# ══════════════════════════════════════════════════════════════════
# TEAMMATCH — Variables de Entorno
# ══════════════════════════════════════════════════════════════════
# Este archivo es un ejemplo de configuración de variables de entorno
# Copia este archivo como ".env" y reemplaza los valores con los reales
# ══════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────
# GENERAL
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ─────────────────────────────────────────────
# JWT — Autenticación
# ─────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h

# ─────────────────────────────────────────────
# NEO4J — Base de datos de grafos
# ─────────────────────────────────────────────
NEO4J_URI=bolt://your_neo4j_uri_here
NEO4J_USER=your_neo4j_user_here
NEO4J_PASSWORD=your_neo4j_password_here

# ─────────────────────────────────────────────
# AI SERVICE — Gemini
# ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
AI_SERVICE_URL=http://ai-service:3001

# ─────────────────────────────────────────────
# Azure OpenAI — M3 Matchmaking
# ─────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://your_azure_openai_endpoint_here
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT_NAME=your_azure_openai_deployment_name_here
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Límites de seguridad para procesamiento de archivos
MAX_FILE_SIZE_MB=5
PROCESSING_TIMEOUT_MS=30000

# ─────────────────────────────────────────────
# SEGURIDAD — Control de acceso
# ─────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=4
LOGIN_BLOCK_DURATION_MS=900000

# ─────────────────────────────────────────────
# FRONTEND — Vite
# ─────────────────────────────────────────────
VITE_API_URL=http://localhost:3000/api