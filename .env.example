# TeamMatch environment variables
#
# Copy this file to .env and replace every value marked with <CAMBIAR>.
# Never commit .env or real secrets to the repository.

# General
NODE_ENV=development
PORT=3000

# JWT authentication
# Generate a strong secret with: openssl rand -hex 64
JWT_SECRET=<CAMBIAR_POR_SECRETO_SEGURO>
JWT_EXPIRES_IN=24h

# CORS
# In production this is required. Use comma-separated origins if needed.
CORS_ORIGIN=http://localhost:5173

# Neo4j graph database
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<CAMBIAR_POR_PASSWORD_SEGURO>

# AI / Gemini
# Create a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<CAMBIAR_POR_TU_API_KEY>
GEMINI_MODEL=gemini-1.5-flash
AI_SERVICE_URL=http://ai-service:8000

# Processing limits
MAX_FILE_SIZE_MB=5
PROCESSING_TIMEOUT_MS=30000

# Login protection
MAX_LOGIN_ATTEMPTS=4
LOGIN_BLOCK_DURATION_MS=900000

# Frontend
VITE_API_URL=http://localhost:3000/api
