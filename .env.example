# TeamMatch environment variables
#
# Copy this file to .env and replace every value marked with <CAMBIAR>.
# Never commit .env or real secrets to the repository.

# General
NODE_ENV=development
PORT=3000

# JWT authentication
# Generate a strong secret with: openssl rand -hex 64
JWT_SECRET=<CAMBIAR_POR_SECRETO_SEGURO>
JWT_EXPIRES_IN=24h

# CORS
# In production this is required. Use comma-separated origins if needed.
CORS_ORIGIN=http://localhost:5173

# Neo4j — Aura (cloud) o local (docker compose con servicio neo4j descomentado)
# Aura: URI neo4j+s://<INSTANCE_ID>.databases.neo4j.io y USER = mismo INSTANCE_ID
NEO4J_URI=neo4j+s://<INSTANCE_ID>.databases.neo4j.io
NEO4J_USER=<INSTANCE_ID>
NEO4J_PASSWORD=<CAMBIAR_POR_PASSWORD_AURA>
# Local Docker: NEO4J_URI=bolt://neo4j:7687  NEO4J_USER=neo4j

# AI Service (Azure OpenAI — gpt-4.1-mini)
AI_SERVICE_URL=http://ai-service:3001
AZURE_OPENAI_ENDPOINT=<CAMBIAR_POR_ENDPOINT_AZURE>
AZURE_OPENAI_API_KEY=<CAMBIAR_POR_API_KEY_AZURE>
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Processing limits (RNF1: timeout Azure OpenAI ≤ 20 s)
MAX_FILE_SIZE_MB=5
PROCESSING_TIMEOUT_MS=20000

# Login protection
MAX_LOGIN_ATTEMPTS=4
LOGIN_BLOCK_DURATION_MS=900000

# Frontend
VITE_API_URL=http://localhost:3000/api
# true = login real, proyectos/habilidades/matchmaking contra Neo4j + backend
VITE_USE_API_AUTH=true
VITE_AI_SERVICE_URL=http://localhost:3001

# Auth — optional register whitelist (comma-separated emails or @domain suffixes)
# AUTH_REGISTER_EMAIL_WHITELIST=@uninorte.edu.co
